# Required for Google SSO (optional — app works without it via email/password)
# Get from https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID, type "Web application"
# Authorized JavaScript origins: http://localhost:5000
# Authorized redirect URIs: http://localhost:5000 (we use Google Identity Services, not OAuth redirect)
#
# NOTE: VITE_GOOGLE_CLIENT_ID is the SAME VALUE as GOOGLE_CLIENT_ID. Vite needs the
# VITE_ prefix to expose the variable to the frontend; the server reads GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session secret (required, any random string)
SESSION_SECRET=replace-with-random-string-in-production
